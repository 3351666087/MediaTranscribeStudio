{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/llm-provider-presets.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "defaults", "providers"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "catalogId": {"type": "string", "minLength": 1},
    "defaults": {"type": "object"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "protocol", "networkPolicy", "apiKeyEnvironmentVariable", "documentation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "displayName": {"type": "string", "minLength": 1},
          "protocol": {"enum": ["ollama", "openai-compatible", "anthropic", "google-gemini"]},
          "endpoint": {"type": ["string", "null"]},
          "networkPolicy": {"enum": ["loopback-only", "remote-explicit"]},
          "apiKeyEnvironmentVariable": {"type": ["string", "null"]},
          "downloadCommand": {"type": "string"},
          "documentation": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
