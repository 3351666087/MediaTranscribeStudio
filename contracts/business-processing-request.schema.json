{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/business-processing-request/1.0.0",
  "title": "MediaTranscribeStudio Business Processing Request",
  "description": "A local-only request for immutable translation, polishing, and summary variants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "translationTargets",
    "polish",
    "summary",
    "model",
    "outputLocale",
    "promptVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "translationTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/languageTag"
      }
    },
    "polish": {
      "type": "boolean"
    },
    "summary": {
      "type": "boolean"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "outputLocale": {
      "$ref": "#/$defs/languageTag"
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^(?![Aa][Uu][Tt][Oo]$)(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WYZa-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+)$"
    }
  }
}
