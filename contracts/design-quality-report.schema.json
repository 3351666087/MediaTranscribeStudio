{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/design-quality-report/1.0.0",
  "title": "MediaTranscribeStudio Design Quality Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "projectRoot",
    "policy",
    "externalDesignPack",
    "checks",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "media-transcribe-studio/design-quality-report"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failClosed",
        "maximumUiMotionMs",
        "allowedTransitionProperties",
        "allowedKeyframeProperties"
      ],
      "properties": {
        "failClosed": {
          "const": true
        },
        "maximumUiMotionMs": {
          "const": 300
        },
        "allowedTransitionProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedKeyframeProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "externalDesignPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passageClaimed",
        "status",
        "blocker",
        "detail"
      ],
      "properties": {
        "passageClaimed": {
          "const": false
        },
        "status": {
          "const": "blocked-upstream-v3-contract"
        },
        "blocker": {
          "const": "repairCatalog.passPolicy is required"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "passed",
        "failed",
        "errors"
      ],
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^DQ-[A-Z0-9-]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "severity": {
          "const": "error"
        },
        "evidence": {
          "type": "object"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "findings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  }
}
