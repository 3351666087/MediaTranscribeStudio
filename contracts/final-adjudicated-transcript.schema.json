{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/final-adjudicated-transcript/1.3.0",
  "title": "Final adjudicated transcript disposition",
  "description": "The only media disposition eligible for formal quality scoring. Transcribable speech requires completed semantic arbitration and resolved review; verified speech absence binds directly to voice-activity evidence without fabricating a transcript.",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/transcribableSpeechArtifact"},
    {"$ref": "#/$defs/composedTranscribableSpeechArtifact"},
    {"$ref": "#/$defs/noSpeechArtifact"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "speakerId": {
      "type": "string",
      "pattern": "^speaker-[1-9][0-9]*$"
    },
    "languageTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^(?![Aa][Uu][Tt][Oo]$)(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WYZa-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+)$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startMs",
        "endMs",
        "speakerId",
        "language",
        "finalText",
        "rawTextSha256",
        "overlapping",
        "humanLocked",
        "revisionCount"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "startMs": {"type": "integer", "minimum": 0},
        "endMs": {"type": "integer", "minimum": 1},
        "speakerId": {"$ref": "#/$defs/speakerId"},
        "language": {"$ref": "#/$defs/languageTag"},
        "finalText": {"type": "string", "minLength": 1},
        "rawTextSha256": {"$ref": "#/$defs/sha256"},
        "overlapping": {"type": "boolean"},
        "humanLocked": {"type": "boolean"},
        "revisionCount": {"type": "integer", "minimum": 0}
      }
    },
    "transcribableSpeechArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "artifactType",
        "artifactId",
        "jobId",
        "documentId",
        "generatedAt",
        "status",
        "disposition",
        "acceptanceSubject",
        "input",
        "semantic",
        "review",
        "source",
        "speakerPolicy",
        "finalTextAuthority",
        "segments"
      ],
      "properties": {
        "schemaVersion": {"const": "1.1.0"},
        "artifactType": {"const": "final-adjudicated-transcript"},
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 240},
        "jobId": {"type": "string", "minLength": 1, "maxLength": 160},
        "documentId": {"type": "string", "minLength": 1, "maxLength": 240},
        "generatedAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"const": "adjudication-complete"},
        "disposition": {"const": "transcribable-speech"},
        "acceptanceSubject": {"const": "speaker-language-time-final-text"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceMediaSha256",
            "transcriptDocumentSha256",
            "semanticInputTranscriptSha256",
            "semanticArtifactSha256",
            "reviewQueueSha256"
          ],
          "properties": {
            "sourceMediaSha256": {"$ref": "#/$defs/sha256"},
            "transcriptDocumentSha256": {"$ref": "#/$defs/sha256"},
            "semanticInputTranscriptSha256": {"$ref": "#/$defs/sha256"},
            "semanticArtifactSha256": {"$ref": "#/$defs/sha256"},
            "reviewQueueSha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "model",
            "promptVersion",
            "applicationPolicy",
            "requiresHumanApproval",
            "suggestionCount",
            "autoAppliedCount"
          ],
          "properties": {
            "status": {"const": "completed"},
            "model": {"type": "string", "minLength": 1, "maxLength": 240},
            "promptVersion": {"type": "string", "minLength": 1, "maxLength": 240},
            "applicationPolicy": {"const": "suggestion-only"},
            "requiresHumanApproval": {"const": true},
            "suggestionCount": {"type": "integer", "minimum": 0},
            "autoAppliedCount": {"const": 0}
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openCount",
            "itemCount",
            "acceptedCount",
            "rejectedCount",
            "decisionCount"
          ],
          "properties": {
            "openCount": {"const": 0},
            "itemCount": {"type": "integer", "minimum": 0},
            "acceptedCount": {"type": "integer", "minimum": 0},
            "rejectedCount": {"type": "integer", "minimum": 0},
            "decisionCount": {"type": "integer", "minimum": 0}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationMs"],
          "properties": {
            "durationMs": {"type": "integer", "minimum": 1}
          }
        },
        "speakerPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolvedCount", "speakerIds"],
          "properties": {
            "resolvedCount": {"type": "integer", "minimum": 1},
            "speakerIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/speakerId"}
            }
          }
        },
        "finalTextAuthority": {"const": "normalizedText"},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/segment"}
        }
      }
    },
    "composedTranscribableSpeechArtifact": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"schemaVersion": {"const": "1.2.0"}},
            "required": ["schemaVersion"]
          },
          "then": {
            "properties": {
              "finalTextAuthority": {
                "const": "semantic-composition-selected-asr-text"
              }
            }
          }
        },
        {
          "if": {
            "properties": {"schemaVersion": {"const": "1.3.0"}},
            "required": ["schemaVersion"]
          },
          "then": {
            "properties": {
              "finalTextAuthority": {
                "const": "manual-text-revision-over-semantic-composition"
              }
            }
          }
        }
      ],
      "required": [
        "schemaVersion",
        "artifactType",
        "artifactId",
        "jobId",
        "documentId",
        "generatedAt",
        "status",
        "disposition",
        "acceptanceSubject",
        "input",
        "semantic",
        "review",
        "source",
        "speakerPolicy",
        "timeline",
        "finalTextAuthority",
        "timelineAuthority",
        "segments"
      ],
      "properties": {
        "schemaVersion": {"enum": ["1.2.0", "1.3.0"]},
        "artifactType": {"const": "final-adjudicated-transcript"},
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 240},
        "jobId": {"type": "string", "minLength": 1, "maxLength": 160},
        "documentId": {"type": "string", "minLength": 1, "maxLength": 240},
        "generatedAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"const": "adjudication-complete"},
        "disposition": {"const": "transcribable-speech"},
        "acceptanceSubject": {
          "const": "speech-speaker-timeline-language-final-text"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceMediaSha256",
            "transcriptDocumentSha256",
            "candidateLatticeSha256",
            "arbitrationArtifactSha256",
            "compositionArtifactSha256",
            "reviewQueueSha256"
          ],
          "properties": {
            "sourceMediaSha256": {"$ref": "#/$defs/sha256"},
            "transcriptDocumentSha256": {"$ref": "#/$defs/sha256"},
            "candidateLatticeSha256": {"$ref": "#/$defs/sha256"},
            "arbitrationArtifactSha256": {"$ref": "#/$defs/sha256"},
            "compositionArtifactSha256": {"$ref": "#/$defs/sha256"},
            "reviewQueueSha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "model",
            "promptVersion",
            "applicationPolicy",
            "requiresHumanApproval",
            "selectedCandidateCount",
            "changedCandidateCount"
          ],
          "properties": {
            "status": {"const": "composition-complete"},
            "model": {"type": "string", "minLength": 1, "maxLength": 240},
            "promptVersion": {"type": "string", "minLength": 1, "maxLength": 240},
            "applicationPolicy": {"const": "mandatory-candidate-selection"},
            "requiresHumanApproval": {"const": false},
            "selectedCandidateCount": {"type": "integer", "minimum": 1},
            "changedCandidateCount": {"type": "integer", "minimum": 0}
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openCount",
            "itemCount",
            "acceptedCount",
            "rejectedCount",
            "decisionCount"
          ],
          "properties": {
            "openCount": {"const": 0},
            "itemCount": {"type": "integer", "minimum": 0},
            "acceptedCount": {"type": "integer", "minimum": 0},
            "rejectedCount": {"type": "integer", "minimum": 0},
            "decisionCount": {"type": "integer", "minimum": 0}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationMs"],
          "properties": {
            "durationMs": {"type": "integer", "minimum": 1}
          }
        },
        "speakerPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolvedCount", "speakerIds"],
          "properties": {
            "resolvedCount": {"type": "integer", "minimum": 1},
            "speakerIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/speakerId"}
            }
          }
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "speakerCount",
            "speakerIds",
            "timelineKind",
            "startMs",
            "endMs",
            "turns"
          ],
          "properties": {
            "speakerCount": {"type": "integer", "minimum": 1},
            "speakerIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/speakerId"}
            },
            "timelineKind": {"type": "string", "minLength": 1, "maxLength": 120},
            "startMs": {"type": "integer", "minimum": 0},
            "endMs": {"type": "integer", "minimum": 1},
            "turns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["startMs", "endMs", "speakerId", "overlap"],
                "properties": {
                  "startMs": {"type": "integer", "minimum": 0},
                  "endMs": {"type": "integer", "minimum": 1},
                  "speakerId": {"$ref": "#/$defs/speakerId"},
                  "overlap": {"type": "boolean"}
                }
              }
            }
          }
        },
        "finalTextAuthority": {
          "enum": [
            "semantic-composition-selected-asr-text",
            "manual-text-revision-over-semantic-composition"
          ]
        },
        "timelineAuthority": {
          "const": "semantic-composition-selected-timeline"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/segment"}
        }
      }
    },
    "noSpeechArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "artifactType",
        "artifactId",
        "jobId",
        "generatedAt",
        "status",
        "disposition",
        "acceptanceSubject",
        "input",
        "source",
        "voiceActivity",
        "segments"
      ],
      "properties": {
        "schemaVersion": {"const": "1.1.0"},
        "artifactType": {"const": "final-adjudicated-transcript"},
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 240},
        "jobId": {"type": "string", "minLength": 1, "maxLength": 160},
        "generatedAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"const": "adjudication-complete"},
        "disposition": {"const": "no-transcribable-speech"},
        "acceptanceSubject": {"const": "lexical-speech-presence"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceMediaSha256",
            "voiceActivitySha256"
          ],
          "properties": {
            "sourceMediaSha256": {"$ref": "#/$defs/sha256"},
            "voiceActivitySha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationMs"],
          "properties": {
            "durationMs": {"type": "integer", "minimum": 1}
          }
        },
        "voiceActivity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "hasSpeechCandidates",
            "hasTranscribableSpeech",
            "speechWindowCount",
            "speechDurationMs"
          ],
          "properties": {
            "classification": {
              "enum": [
                "no-speech-candidates-detected",
                "no-lexical-speech-detected"
              ]
            },
            "hasSpeechCandidates": {"type": "boolean"},
            "hasTranscribableSpeech": {"const": false},
            "speechWindowCount": {"type": "integer", "minimum": 0},
            "speechDurationMs": {"type": "integer", "minimum": 0}
          }
        },
        "segments": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
