{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/polish-output/1.0.0",
  "title": "MediaTranscribeStudio Polished Transcript Variant",
  "description": "A source-language semantic-polish variant with an explicit audit diff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "variant",
    "inputHash",
    "model",
    "promptVersion",
    "provider",
    "temperature",
    "status",
    "language",
    "applicationPolicy",
    "requiresHumanApproval",
    "segments",
    "diff"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "variant": {
      "const": "polish"
    },
    "inputHash": {
      "$ref": "#/$defs/sha256"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "temperature": {
      "const": 0
    },
    "status": {
      "const": "completed"
    },
    "language": {
      "$ref": "#/$defs/languageTag"
    },
    "applicationPolicy": {
      "const": "suggestion-only"
    },
    "requiresHumanApproval": {
      "const": true
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "diff": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diff"
      }
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^(?![Aa][Uu][Tt][Oo]$)(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WYZa-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "networkPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "networkPolicy": {
          "const": "loopback-only"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "speakerId",
        "startMs",
        "endMs",
        "sourceTextHash",
        "text",
        "language",
        "diffReason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "speakerId": {
          "type": "string",
          "pattern": "^speaker-[1-9][0-9]*$"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "humanLocked": {
          "type": "boolean",
          "description": "Immutable source review lock copied by the trusted backend."
        },
        "sourceTextHash": {
          "$ref": "#/$defs/sha256"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "diffReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "before",
        "after",
        "reason"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
