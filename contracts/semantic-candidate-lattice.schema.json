{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/semantic-candidate-lattice/1.0.0",
  "title": "Hash-bound semantic candidate lattice",
  "description": "Cross-model candidate outcomes supplied to mandatory semantic arbitration. Runtime validation recomputes candidate, group, and lattice identities and all availability fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "latticeId",
    "latticeSha256",
    "binding",
    "requiredDomains",
    "availability",
    "domains"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "artifactType": {
      "const": "semantic-candidate-lattice"
    },
    "latticeId": {
      "type": "string",
      "pattern": "^semantic-lattice-[a-f0-9]{24}$"
    },
    "latticeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMediaSha256",
        "transcriptSha256",
        "transcriptSchemaVersion",
        "sourceDurationMs"
      ],
      "properties": {
        "sourceMediaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "transcriptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "transcriptSchemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "sourceDurationMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requiredDomains": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "const": "speech-disposition"
        },
        {
          "const": "speaker-cardinality-timeline"
        },
        {
          "const": "speaker-assignment"
        },
        {
          "const": "language-span"
        },
        {
          "const": "asr-text"
        }
      ],
      "items": false
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allRequiredDomainsAvailable",
        "requiredDomainCount",
        "availableDomainCount",
        "partialDomainCount",
        "unavailableDomainCount",
        "groupCount",
        "availableGroupCount",
        "unavailableGroupCount"
      ],
      "properties": {
        "allRequiredDomainsAvailable": {
          "type": "boolean"
        },
        "requiredDomainCount": {
          "const": 5
        },
        "availableDomainCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "partialDomainCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "unavailableDomainCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "groupCount": {
          "type": "integer",
          "minimum": 0
        },
        "availableGroupCount": {
          "type": "integer",
          "minimum": 0
        },
        "unavailableGroupCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "languageTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^(?![Aa][Uu][Tt][Oo]$)(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WYZa-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+)$"
    },
    "domainName": {
      "enum": [
        "speech-disposition",
        "speaker-cardinality-timeline",
        "speaker-assignment",
        "language-span",
        "asr-text"
      ]
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "status",
        "unavailableReason",
        "groupCount",
        "availableGroupCount",
        "unavailableGroupCount",
        "groups"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/domainName"
        },
        "status": {
          "enum": [
            "available",
            "partial",
            "candidate-domain-unavailable"
          ]
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "groupCount": {
          "type": "integer",
          "minimum": 0
        },
        "availableGroupCount": {
          "type": "integer",
          "minimum": 0
        },
        "unavailableGroupCount": {
          "type": "integer",
          "minimum": 0
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "scopeId",
        "status",
        "unavailableReason",
        "currentCandidateId",
        "candidateCount",
        "eligibleCandidateCount",
        "candidates"
      ],
      "properties": {
        "groupId": {
          "type": "string",
          "pattern": "^group-[a-f0-9]{24}$"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": [
            "available",
            "candidate-domain-unavailable"
          ]
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "currentCandidateId": {
          "type": "string",
          "pattern": "^candidate-[a-f0-9]{24}$"
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 1
        },
        "eligibleCandidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "domain",
        "scopeId",
        "payloadSha256",
        "selectionEligible",
        "eligibilityReason",
        "producers",
        "payload"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^candidate-[a-f0-9]{24}$"
        },
        "domain": {
          "$ref": "#/$defs/domainName"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "payloadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "selectionEligible": {
          "type": "boolean"
        },
        "eligibilityReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "producers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/producer"
          }
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/speechPayload"
            },
            {
              "$ref": "#/$defs/timelinePayload"
            },
            {
              "$ref": "#/$defs/speakerAssignmentPayload"
            },
            {
              "$ref": "#/$defs/languageSpanPayload"
            },
            {
              "$ref": "#/$defs/asrTextPayload"
            }
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerType",
        "systemId",
        "revision",
        "artifactSha256",
        "modelManifestSha256",
        "identityStatus"
      ],
      "properties": {
        "producerType": {
          "enum": [
            "model",
            "deterministic",
            "human"
          ]
        },
        "systemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "modelManifestSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "identityStatus": {
          "enum": [
            "manifest-bound",
            "artifact-bound",
            "human-attested",
            "unverified"
          ]
        }
      }
    },
    "speechPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "startMs",
        "endMs"
      ],
      "properties": {
        "classification": {
          "enum": [
            "transcribable-speech",
            "no-transcribable-speech"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "speechDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "speechRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "speechWindowCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "dependentRequired": {
        "speechDurationMs": [
          "speechRatio",
          "speechWindowCount"
        ],
        "speechRatio": [
          "speechDurationMs",
          "speechWindowCount"
        ],
        "speechWindowCount": [
          "speechDurationMs",
          "speechRatio"
        ]
      }
    },
    "timelinePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerCount",
        "speakerIds",
        "timelineKind",
        "startMs",
        "endMs",
        "turns"
      ],
      "properties": {
        "speakerCount": {
          "type": "integer",
          "minimum": 1
        },
        "speakerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^speaker-[1-9][0-9]*$"
          }
        },
        "timelineKind": {
          "enum": [
            "current-transcript",
            "overlap-preserving",
            "single-speaker",
            "challenger"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/turn"
          }
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startMs",
        "endMs",
        "speakerId",
        "overlap"
      ],
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "speakerId": {
          "type": "string",
          "pattern": "^speaker-[1-9][0-9]*$"
        },
        "overlap": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "speakerAssignmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "startMs",
        "endMs",
        "speakerId",
        "score"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "speakerId": {
          "type": "string",
          "pattern": "^speaker-[1-9][0-9]*$"
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "languageSpanPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "startMs",
        "endMs",
        "language",
        "confidence"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evidenceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "asrTextPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "startMs",
        "endMs",
        "text",
        "language",
        "sourceCandidateId",
        "candidateSetSha256"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "sourceCandidateId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "candidateSetSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
