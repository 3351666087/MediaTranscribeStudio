{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/semantic-composition/1.0.0",
  "title": "Deterministic semantic composition",
  "description": "The isolated final state produced only from selected, hash-bound candidates after complete job-level arbitration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "compositionSha256",
    "jobId",
    "generatedAt",
    "status",
    "disposition",
    "acceptanceSubject",
    "binding",
    "speakerPolicy",
    "timeline",
    "segments",
    "selectionTrace",
    "selectedLattice",
    "humanLocksPreserved"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "artifactType": {
      "const": "semantic-composition"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^semantic-composition-[a-f0-9]{24}$"
    },
    "compositionSha256": {
      "$ref": "#/$defs/sha256"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "status": {
      "const": "composition-complete"
    },
    "disposition": {
      "enum": [
        "transcribable-speech",
        "no-transcribable-speech"
      ]
    },
    "acceptanceSubject": {
      "const": "speech-speaker-timeline-language-final-text"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMediaSha256",
        "transcriptSha256",
        "inputLatticeSha256",
        "arbitrationArtifactSha256",
        "selectedLatticeSha256"
      ],
      "properties": {
        "sourceMediaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "transcriptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "inputLatticeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "arbitrationArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "selectedLatticeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "speakerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolvedCount",
        "speakerIds"
      ],
      "properties": {
        "resolvedCount": {
          "type": "integer",
          "minimum": 1
        },
        "speakerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/speakerId"
          }
        }
      }
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "selectionTrace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trace"
      }
    },
    "selectedLattice": {
      "type": "object"
    },
    "humanLocksPreserved": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "no-transcribable-speech"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "segments": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "segments": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "speakerId": {
      "type": "string",
      "pattern": "^speaker-[1-9][0-9]*$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^candidate-[a-f0-9]{24}$"
    },
    "groupId": {
      "type": "string",
      "pattern": "^group-[a-f0-9]{24}$"
    },
    "domain": {
      "enum": [
        "speech-disposition",
        "speaker-cardinality-timeline",
        "speaker-assignment",
        "language-span",
        "asr-text"
      ]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startMs",
        "endMs",
        "speakerId",
        "overlap"
      ],
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "speakerId": {
          "$ref": "#/$defs/speakerId"
        },
        "overlap": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerCount",
        "speakerIds",
        "timelineKind",
        "startMs",
        "endMs",
        "turns"
      ],
      "properties": {
        "speakerCount": {
          "type": "integer",
          "minimum": 1
        },
        "speakerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/speakerId"
          }
        },
        "timelineKind": {
          "enum": [
            "current-transcript",
            "overlap-preserving",
            "single-speaker",
            "challenger"
          ]
        },
        "startMs": {
          "const": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/turn"
          }
        }
      }
    },
    "selectedCandidateIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerAssignment",
        "languageSpan",
        "asrText"
      ],
      "properties": {
        "speakerAssignment": {
          "$ref": "#/$defs/candidateId"
        },
        "languageSpan": {
          "$ref": "#/$defs/candidateId"
        },
        "asrText": {
          "$ref": "#/$defs/candidateId"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startMs",
        "endMs",
        "speakerId",
        "language",
        "finalText",
        "rawTextSha256",
        "overlapping",
        "humanLocked",
        "selectedCandidateIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "speakerId": {
          "$ref": "#/$defs/speakerId"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 255
        },
        "finalText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "rawTextSha256": {
          "$ref": "#/$defs/sha256"
        },
        "overlapping": {
          "type": "boolean"
        },
        "humanLocked": {
          "type": "boolean"
        },
        "selectedCandidateIds": {
          "$ref": "#/$defs/selectedCandidateIds"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "groupId",
        "scopeId",
        "candidateId",
        "payloadSha256",
        "producerArtifactSha256"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "groupId": {
          "$ref": "#/$defs/groupId"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidateId": {
          "$ref": "#/$defs/candidateId"
        },
        "payloadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "producerArtifactSha256": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
