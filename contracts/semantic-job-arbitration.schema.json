{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/semantic-job-arbitration/1.1.0",
  "title": "Job-level semantic candidate arbitration",
  "description": "A complete-job local-model decision that either ranks every eligible candidate in a group or requests a bounded domain challenger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "decisionSha256",
    "jobId",
    "generatedAt",
    "binding",
    "model",
    "provider",
    "promptVersion",
    "status",
    "selections",
    "candidateGenerationRequests",
    "translationTargets",
    "translations",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "artifactType": {
      "const": "semantic-job-arbitration"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^semantic-arbitration-[a-f0-9]{24}$"
    },
    "decisionSha256": {
      "$ref": "#/$defs/sha256"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMediaSha256",
        "transcriptSha256",
        "latticeId",
        "latticeSha256"
      ],
      "properties": {
        "sourceMediaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "transcriptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "latticeId": {
          "$ref": "#/$defs/latticeId"
        },
        "latticeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "networkPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "networkPolicy": {
          "enum": [
            "loopback-only",
            "remote-explicit"
          ]
        }
      }
    },
    "promptVersion": {
      "enum": [
        "semantic-job-candidate-arbitration-v1",
        "semantic-job-candidate-arbitration-v2",
        "semantic-job-candidate-arbitration-v3",
        "semantic-job-candidate-arbitration-v4",
        "semantic-job-candidate-arbitration-v5",
        "semantic-job-candidate-arbitration-v6",
        "semantic-job-candidate-arbitration-v7",
        "semantic-job-candidate-arbitration-v8",
        "semantic-job-candidate-arbitration-v9",
        "semantic-job-candidate-arbitration-v10",
        "semantic-job-candidate-arbitration-v11",
        "semantic-job-candidate-arbitration-v12",
        "semantic-job-candidate-arbitration-v13",
        "semantic-job-candidate-arbitration-v14",
        "semantic-job-candidate-arbitration-v15",
        "semantic-job-candidate-arbitration-v16",
        "semantic-job-candidate-arbitration-v17"
      ]
    },
    "status": {
      "enum": [
        "ready-to-compose",
        "candidate-generation-required"
      ]
    },
    "selections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "candidateGenerationRequests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generationRequest"
      }
    },
    "translationTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/languageTag"
      }
    },
    "translations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/translation"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateGroupCount",
        "selectedGroupCount",
        "candidateGenerationRequestCount",
        "unresolvedGroupCount",
        "unresolvedDomainCount"
      ],
      "properties": {
        "candidateGroupCount": {
          "type": "integer",
          "minimum": 0
        },
        "selectedGroupCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidateGenerationRequestCount": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedGroupCount": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedDomainCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "latticeId": {
      "type": "string",
      "pattern": "^semantic-lattice-[a-f0-9]{24}$"
    },
    "groupId": {
      "type": "string",
      "pattern": "^group-[a-f0-9]{24}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^candidate-[a-f0-9]{24}$"
    },
    "languageTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^(?![Aa][Uu][Tt][Oo]$)(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WYZa-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+)$"
    },
    "domain": {
      "enum": [
        "speech-disposition",
        "speaker-cardinality-timeline",
        "speaker-assignment",
        "language-span",
        "asr-text"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_:-]+$",
        "maxLength": 96
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 220
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "groupId",
        "scopeId",
        "selectedCandidateId",
        "rankedCandidateIds",
        "reasonCodes",
        "evidenceRefs"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "groupId": {
          "$ref": "#/$defs/groupId"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "selectedCandidateId": {
          "$ref": "#/$defs/candidateId"
        },
        "rankedCandidateIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidateId"
          }
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "generationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "groupId",
        "scopeId",
        "requestKind",
        "minimumAlternativeCount",
        "reasonCodes",
        "evidenceRefs"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "groupId": {
          "oneOf": [
            {
              "$ref": "#/$defs/groupId"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requestKind": {
          "enum": [
            "speech-disposition-challenger",
            "vad-lexical-recompute",
            "timeline-challenger",
            "boundary-recompute",
            "speaker-assignment-challenger",
            "speaker-embedding-recompute",
            "open-set-lid",
            "language-boundary-recompute",
            "provider-native-nbest",
            "local-asr-redecode"
          ]
        },
        "minimumAlternativeCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "selectedCandidateId",
        "sourceTextSha256",
        "targetLanguage",
        "text"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "selectedCandidateId": {
          "$ref": "#/$defs/candidateId"
        },
        "sourceTextSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetLanguage": {
          "$ref": "#/$defs/languageTag"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    }
  }
}
