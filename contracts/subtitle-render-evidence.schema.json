{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/subtitle-render-evidence/1.0.0",
  "title": "MediaTranscribeStudio Subtitle Render Evidence",
  "description": "Canonical request/result contract for collecting real, local, representative-frame evidence that can be consumed directly by subtitle-visual-qa. The result binds immutable media, explicit FFmpeg tools, deterministic frame selection, pixel analysis, cue/speaker/style identity, and an exact visual-QA request. Positive font claims require collector-computed hashes of real evidence and font artifacts; this contract never creates word timing.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "configurationSha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "configurationSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "mediaSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sizeBytes",
        "mtimeNs",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "mtimeNs": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "renderArtifactRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer",
        "rendererVersion",
        "renderConfigurationSha256"
      ],
      "properties": {
        "renderer": {
          "$ref": "#/$defs/identifier"
        },
        "rendererVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "renderConfigurationSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "renderArtifactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sizeBytes",
        "mtimeNs",
        "sha256",
        "renderer",
        "rendererVersion",
        "renderConfigurationSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "mtimeNs": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "renderer": {
          "$ref": "#/$defs/identifier"
        },
        "rendererVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "renderConfigurationSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerId",
        "color"
      ],
      "properties": {
        "speakerId": {
          "$ref": "#/$defs/identifier"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "timedWord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "startMs",
        "endMs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "endMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        }
      }
    },
    "authenticWordTimingEvidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "verified",
            "evidenceArtifactSha256",
            "cueTextSha256",
            "words"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "forced-aligner",
                "native-word-timestamps",
                "human-authored"
              ]
            },
            "verified": {
              "const": true
            },
            "evidenceArtifactSha256": {
              "$ref": "#/$defs/sha256"
            },
            "cueTextSha256": {
              "$ref": "#/$defs/sha256"
            },
            "words": {
              "type": "array",
              "maxItems": 100000,
              "items": {
                "$ref": "#/$defs/timedWord"
              }
            }
          }
        }
      ]
    },
    "evidenceCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cueId",
        "startMs",
        "endMs",
        "text",
        "speakerId",
        "styleId",
        "renderedLines",
        "karaokeMode",
        "wordTimingEvidence",
        "bounds",
        "requestedFontFamilies"
      ],
      "properties": {
        "cueId": {
          "$ref": "#/$defs/identifier"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "endMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000,
          "pattern": "^\\S(?:.|\\n)*\\S$|^\\S$"
        },
        "speakerId": {
          "$ref": "#/$defs/identifier"
        },
        "styleId": {
          "$ref": "#/$defs/identifier"
        },
        "renderedLines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "karaokeMode": {
          "type": "string",
          "enum": [
            "none",
            "word-progress"
          ]
        },
        "wordTimingEvidence": {
          "$ref": "#/$defs/authenticWordTimingEvidence"
        },
        "bounds": {
          "$ref": "#/$defs/rect"
        },
        "requestedFontFamilies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        }
      }
    },
    "samplingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "candidateFractions"
      ],
      "properties": {
        "strategy": {
          "const": "cue-interior-contrast-candidates-v1"
        },
        "candidateFractions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 0.99
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "collectionId",
        "sourceMediaPath",
        "renderedMediaPath",
        "renderArtifact",
        "policy",
        "sampling",
        "speakers",
        "cues"
      ],
      "properties": {
        "kind": {
          "const": "subtitle-render-evidence-request"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "collectionId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceMediaPath": {
          "$ref": "#/$defs/path"
        },
        "renderedMediaPath": {
          "$ref": "#/$defs/path"
        },
        "renderArtifact": {
          "$ref": "#/$defs/renderArtifactRequest"
        },
        "policy": {
          "$ref": "https://mediatranscribestudio.local/contracts/subtitle-visual-qa/1.0.0#/$defs/policy"
        },
        "sampling": {
          "$ref": "#/$defs/samplingRequest"
        },
        "speakers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/speaker"
          }
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/$defs/evidenceCue"
          }
        }
      }
    },
    "toolEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "executableSha256",
        "versionLine",
        "versionArtifactSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "executableSha256": {
          "$ref": "#/$defs/sha256"
        },
        "versionLine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "versionArtifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cueId",
        "fraction",
        "requestedTimestampMs",
        "decodedTimestampMs",
        "frameId"
      ],
      "properties": {
        "cueId": {
          "$ref": "#/$defs/identifier"
        },
        "fraction": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.99
        },
        "requestedTimestampMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "decodedTimestampMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "frameId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "frameRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameId",
        "requestedTimestampMs",
        "decodedTimestampMs",
        "cueIds",
        "renderedImageSha256",
        "sourceImageSha256"
      ],
      "properties": {
        "frameId": {
          "$ref": "#/$defs/identifier"
        },
        "requestedTimestampMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "decodedTimestampMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "cueIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "renderedImageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceImageSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "candidateFractions",
        "sourceMediaSha256",
        "renderArtifactSha256",
        "candidates",
        "frames",
        "selectionArtifactSha256"
      ],
      "properties": {
        "strategy": {
          "const": "cue-interior-contrast-candidates-v1"
        },
        "candidateFractions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 0.99
          }
        },
        "sourceMediaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "renderArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9000000,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/frameRecord"
          }
        },
        "selectionArtifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameId",
        "cueId",
        "speakerId",
        "styleId",
        "bindingArtifactSha256"
      ],
      "properties": {
        "frameId": {
          "$ref": "#/$defs/identifier"
        },
        "cueId": {
          "$ref": "#/$defs/identifier"
        },
        "speakerId": {
          "$ref": "#/$defs/identifier"
        },
        "styleId": {
          "$ref": "#/$defs/identifier"
        },
        "bindingArtifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "collectionId",
        "requestSha256",
        "sourceMedia",
        "renderArtifact",
        "tools",
        "components",
        "selection",
        "bindings",
        "qaRequest",
        "qaRequestSha256",
        "evidenceArtifactSha256"
      ],
      "properties": {
        "kind": {
          "const": "subtitle-render-evidence-result"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "collectionId": {
          "$ref": "#/$defs/identifier"
        },
        "requestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceMedia": {
          "$ref": "#/$defs/mediaSnapshot"
        },
        "renderArtifact": {
          "$ref": "#/$defs/renderArtifactResult"
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ffmpeg",
            "ffprobe"
          ],
          "properties": {
            "ffmpeg": {
              "$ref": "#/$defs/toolEvidence"
            },
            "ffprobe": {
              "$ref": "#/$defs/toolEvidence"
            }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frameAnalyzer",
            "fontEvidenceProvider"
          ],
          "properties": {
            "frameAnalyzer": {
              "$ref": "#/$defs/component"
            },
            "fontEvidenceProvider": {
              "$ref": "#/$defs/component"
            }
          }
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000000,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "qaRequest": {
          "$ref": "https://mediatranscribestudio.local/contracts/subtitle-visual-qa/1.0.0#/$defs/request"
        },
        "qaRequestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidenceArtifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
