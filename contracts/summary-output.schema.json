{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/summary-output/1.1.0",
  "title": "MediaTranscribeStudio Evidence-Grounded Summary Variant",
  "description": "A local-model summary whose actionable claims point back to immutable transcript segments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "variant",
    "inputHash",
    "model",
    "promptVersion",
    "provider",
    "temperature",
    "applicationPolicy",
    "requiresHumanApproval",
    "status",
    "language",
    "executiveSummary",
    "keyPoints",
    "topics",
    "actionItems"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "variant": {
      "const": "summary"
    },
    "inputHash": {
      "$ref": "#/$defs/sha256"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "temperature": {
      "const": 0
    },
    "applicationPolicy": {
      "const": "suggestion-only"
    },
    "requiresHumanApproval": {
      "const": true
    },
    "status": {
      "const": "completed"
    },
    "language": {
      "$ref": "#/$defs/languageTag"
    },
    "executiveSummary": {
      "type": "string",
      "minLength": 1
    },
    "keyPoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "actionItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionItem"
      }
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^(?![Aa][Uu][Tt][Oo]$)(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WYZa-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "networkPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "networkPolicy": {
          "const": "loopback-only"
        }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startMs",
        "endMs"
      ],
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceSegmentIds",
        "timeRange"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSegmentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Every ID is additionally checked at runtime against the immutable source transcript.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "timeRange": {
          "$ref": "#/$defs/timeRange"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceSegmentIds",
        "timeRange"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSegmentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "timeRange": {
          "$ref": "#/$defs/timeRange"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "dueDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "priority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    }
  }
}
