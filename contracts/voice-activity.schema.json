{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/voice-activity/1.0.0",
  "title": "MediaTranscribeStudio Voice Activity Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "jobId",
    "sourceSha256",
    "mediaDurationMs",
    "normalizationProfile",
    "provider",
    "minimumWindowMs",
    "classification",
    "hasSpeechCandidates",
    "hasTranscribableSpeech",
    "speechWindowCount",
    "speechDurationMs",
    "speechRatio",
    "windows"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "artifactType": {"const": "voice-activity"},
    "jobId": {"type": "string", "minLength": 1},
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mediaDurationMs": {"type": "integer", "minimum": 1},
    "normalizationProfile": {"type": "string", "minLength": 1},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "minimumWindowMs": {"type": "integer", "minimum": 1},
    "classification": {
      "enum": [
        "no-speech-candidates-detected",
        "no-lexical-speech-detected",
        "transcribable-speech-detected"
      ]
    },
    "hasSpeechCandidates": {"type": "boolean"},
    "hasTranscribableSpeech": {"type": "boolean"},
    "speechWindowCount": {"type": "integer", "minimum": 0},
    "speechDurationMs": {"type": "integer", "minimum": 0},
    "speechRatio": {"type": "number", "minimum": 0, "maximum": 1},
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startMs", "endMs", "durationMs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "startMs": {"type": "integer", "minimum": 0},
          "endMs": {"type": "integer", "minimum": 1},
          "durationMs": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
