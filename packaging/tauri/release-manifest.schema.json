{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribe.studio/schemas/tauri-release-manifest-v1.json",
  "title": "MediaTranscribe Studio Tauri Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "appId",
    "productName",
    "releaseId",
    "version",
    "architecture",
    "channel",
    "sourceDateEpoch",
    "entrypoint",
    "build",
    "compatibility",
    "trust",
    "payload",
    "nativeInstallers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "contract": {
      "const": "mts-tauri-release/v1"
    },
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{1,126}[A-Za-z0-9])?$"
    },
    "productName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "architecture": {
      "enum": [
        "x64",
        "arm64"
      ]
    },
    "channel": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "entrypoint": {
      "$ref": "#/$defs/relativePath"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetTriple",
        "gitCommit"
      ],
      "properties": {
        "targetTriple": {
          "enum": [
            "x86_64-pc-windows-msvc",
            "aarch64-pc-windows-msvc"
          ]
        },
        "gitCommit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minInstalledVersion",
        "maxInstalledVersion",
        "dataSchema"
      ],
      "properties": {
        "minInstalledVersion": {
          "oneOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxInstalledVersion": {
          "oneOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readableMin",
            "readableMax",
            "writeVersion"
          ],
          "properties": {
            "readableMin": {
              "type": "integer",
              "minimum": 1
            },
            "readableMax": {
              "type": "integer",
              "minimum": 1
            },
            "writeVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "trust": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "publisherThumbprint",
            "signedFiles",
            "manifestSignature"
          ],
          "properties": {
            "mode": {
              "const": "authenticode"
            },
            "publisherThumbprint": {
              "type": "string",
              "pattern": "^[A-F0-9]{40}$"
            },
            "signedFiles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(payload|installers)/[^\\\\:]+$"
              }
            },
            "manifestSignature": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "format",
                "digestAlgorithm"
              ],
              "properties": {
                "path": {
                  "const": "release-manifest.json.p7s"
                },
                "format": {
                  "const": "cms-detached"
                },
                "digestAlgorithm": {
                  "const": "sha256"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "publisherThumbprint",
            "signedFiles",
            "manifestSignature"
          ],
          "properties": {
            "mode": {
              "const": "development-unsigned"
            },
            "publisherThumbprint": {
              "type": "null"
            },
            "signedFiles": {
              "type": "array",
              "maxItems": 0
            },
            "manifestSignature": {
              "type": "null"
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "fileCount",
        "totalBytes",
        "files"
      ],
      "properties": {
        "root": {
          "const": "payload"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileLedgerEntry"
          }
        }
      }
    },
    "nativeInstallers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileLedgerEntry"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:).+$"
    },
    "fileLedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
