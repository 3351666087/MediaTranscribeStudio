{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediatranscribestudio.local/contracts/pdf-inspection/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "openable",
    "pageCount",
    "allPagesA4",
    "transcriptTextIntegrity",
    "segmentCountIntegrity",
    "timestampIntegrity",
    "speakerSetIntegrity",
    "allFontsEmbedded",
    "searchableText",
    "noReplacementCharacters",
    "extractedTextSha256",
    "pages",
    "fonts",
    "missingSegmentIds",
    "duplicateSegmentIds",
    "missingTimestamps",
    "missingSpeakerIds"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "openable": {"type": "boolean"},
    "pageCount": {"type": "integer", "minimum": 0},
    "allPagesA4": {"type": "boolean"},
    "transcriptTextIntegrity": {"type": "boolean"},
    "segmentCountIntegrity": {"type": "boolean"},
    "timestampIntegrity": {"type": "boolean"},
    "speakerSetIntegrity": {"type": "boolean"},
    "allFontsEmbedded": {"type": "boolean"},
    "searchableText": {"type": "boolean"},
    "noReplacementCharacters": {"type": "boolean"},
    "extractedTextSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "failure": {"type": "string"},
    "pages": {"type": "array", "items": {"type": "object"}},
    "fonts": {"type": "array", "items": {"type": "object"}},
    "missingSegmentIds": {"type": "array", "items": {"type": "string"}},
    "duplicateSegmentIds": {"type": "array", "items": {"type": "string"}},
    "missingTimestamps": {"type": "array", "items": {"type": "string"}},
    "missingSpeakerIds": {"type": "array", "items": {"type": "string"}}
  }
}
