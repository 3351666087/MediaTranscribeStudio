    "qwen3ForcedAligner": "D:/models/qwen/Qwen3-ForcedAligner-0.6B",
    "camPlus": "D:/models/funasr/campplus",
    "secondarySpeakerVerifier": {
      "path": "D:/models/modelscope/eres2netv2w24s4ep4",
      "deploymentSlot": "secondary-speaker-verification",
      "registryModelId": "eres2netv2-w24s4ep4",
      "manifestModelKey": "eres2netV2LargeCandidate",
      "manifestSha256": "sha256:c635880504cbacbc95adbc96a4c1567585c4f229426054c64067cfbead2a0ed9",
      "adapterId": "modelscope-eres2netv2"
    },
    "pyannote": "D:/models/pyannote/speaker-diarization-community-1",
    "mossformer2Separation": null
  },
  "executables": {
    "ffmpeg": "ffmpeg",
    "java": "java",
