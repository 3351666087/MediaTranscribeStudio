      "D:/Downloads"
    ],
    "allowedOutputRoot": "D:/MediaTranscribeStudio/outputs",
    "cacheRoot": "D:/MediaTranscribeStudio/cache"
  },
  "models": {
    "funasrVad": "D:/models/funasr/fsmn-vad",
